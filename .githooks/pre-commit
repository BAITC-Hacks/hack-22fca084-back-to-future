#!/bin/sh
# Не даёт коммиту уйти от чужого имени.
#
# Работа идёт с одной машины: рядом четыре клона, в каждом своя ветка и своя
# личность. Перепутать каталог здесь стоит дороже всего — участие на хакатоне
# засчитывается по коммитам из аккаунта участника, а замечают подмену на
# защите, когда чинить поздно. Поэтому проверка механическая, а не правило в
# регламенте.
#
# Проверяется тройка: имя каталога = имя ветки = почта, назначенная этому
# каталогу в workspace.env. Файла нет — раскладка не развёрнута, и тогда
# проверяется только то, что почта вообще настроена.

root=$(git rev-parse --show-toplevel) || exit 1
here=$(basename "$root")
branch=$(git branch --show-current)
email=$(git config user.email || echo "")
config="$(dirname "$root")/workspace.env"

fail() {
	echo "pre-commit: $1" >&2
	echo "проверить: make whoami" >&2
	exit 1
}

if [ -z "$branch" ]; then
	fail "HEAD не на ветке (detached HEAD) — коммит уйдёт в никуда"
fi

if [ -z "$email" ]; then
	fail "не настроена почта: коммит уйдёт от глобальной личности git,
  и участие по нему не засчитают. Выполнить make init"
fi

[ -f "$config" ] || exit 0

if [ "$here" != "$branch" ]; then
	fail "каталог «$here», а ветка «$branch» — они обязаны совпадать.
  Работать нужно в каталоге своей ветки, а не переключать ветки в чужом"
fi

# Ожидаемая почта каталога: mansur → $MANSUR_EMAIL.
# shellcheck disable=SC1090
. "$config"
expected=$(eval "printf '%s' \"\${$(printf '%s' "$here" | tr '[:lower:]' '[:upper:]')_EMAIL-}\"")

if [ -n "$expected" ] && [ "$email" != "$expected" ]; then
	fail "каталог «$here» закреплён за <$expected>, а коммит уйдёт от <$email>.
  Выполнить make init, чтобы восстановить личность каталога"
fi

exit 0
