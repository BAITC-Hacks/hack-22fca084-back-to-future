#!/bin/sh
# Отклоняет упоминания авторства ИИ в сообщении коммита.
# До проверки вырезаем легальные имена путей репозитория: `AGENTS.md`,
# `.codex/` и `.agents/` — это файлы, которые правят по ходу работы, и коммит
# «Добавить скил в .agents/skills» отклоняться не должен.
# Слова `openai` и `gpt` намеренно НЕ запрещены: проект — ИИ-агент, и
# «Подключить вызов модели OpenAI» описывает код, а не авторство коммита.
# Регистр перебираем классами, а не флагом /I: его нет в sed вне GNU.
msg=$(grep -v '^#' "$1" \
  | sed -e 's#[Aa][Gg][Ee][Nn][Tt][Ss]\.[Mm][Dd]##g' \
        -e 's#\.[Cc][Oo][Dd][Ee][Xx]/*##g' \
        -e 's#\.[Aa][Gg][Ee][Nn][Tt][Ss]/*##g')
if echo "$msg" | grep -qiE 'codex|claude|anthropic|co-authored-by|generated with'; then
  echo "commit-msg: запрещённое упоминание авторства ИИ в сообщении коммита" >&2
  exit 1
fi
exit 0
