# Неизменяемая часть Makefile: запуск проекта.
# Подключается проектом строкой
#   include make/compose.mk
#
# Проект живёт в контейнерах, поэтому цели запуска приезжают вместе с
# экосистемой, а не пишутся заново в каждом репозитории. Имя проекта compose
# берётся из имени каталога — это и разводит четыре клона между собой.
#
# Свои цели (миграции, тесты, линт) проект дописывает в собственный Makefile,
# этот файл не правит.

.PHONY: up down restart build logs ps

## up: собрать образы и поднять стек
up:
	docker compose up -d --build

## down: остановить стек; тома и данные остаются на месте
down:
	docker compose down

## restart: перезапустить стек с пересборкой
restart: down up

## build: собрать образы, не поднимая стек
build:
	docker compose build

## logs: логи всех сервисов, последние 200 строк, с продолжением
logs:
	docker compose logs -f --tail=200

## ps: что сейчас поднято и на каких портах
ps:
	docker compose ps
